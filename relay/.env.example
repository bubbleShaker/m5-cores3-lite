# 共有トークン（必須・#216）。実機の src/secrets.h の RELAY_TOKEN と同じ値にする。
# /health 以外の全エンドポイントで X-Relay-Token ヘッダの一致を要求する。
#
# ⚠ 下の値は**わざと短くしてある**。書き換えないとサーバは起動しない。
#   未設定・16 文字未満・テンプレートのままのいずれもサーバが起動を拒否する
#   （無認証や「public リポジトリに載っている既知のトークン」で立ち上がる事故を防ぐため）。
# 生成例: openssl rand -hex 16
RELAY_TOKEN=CHANGE_ME
# Anthropic API キー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 待ち受けポート（省略時 3000）
PORT=3000
# VOICEVOX ENGINE の所在（/tts 用・省略時 http://localhost:50021）
VOICEVOX_URL=http://localhost:50021
# 自前ホスト Whisper の所在（/stt 用・省略時 http://localhost:9000）
STT_URL=http://localhost:9000
