#pragma once
// Wi-Fi 認証情報のテンプレート。
//
// 使い方:
//   1. このファイルを同じ src/ に secrets.h という名前でコピーする
//   2. 下の値を自分の Wi-Fi に書き換える
//
// secrets.h は .gitignore で git 管理外（コミットされない）。
// 認証情報はファームウェアにのみ存在し、リポジトリには一切含めない。

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// 中継サーバ(②-2b)の /chat エンドポイント。
// ローカル実行時は中継サーバを動かす PC の LAN IP を指す（例: 192.168.1.10:3000）。
// 音声(/tts)はこの URL の末尾 /chat を /tts に置換して自動導出するので、別定義は不要。
#define RELAY_URL "http://192.168.1.10:3000/chat"

// 中継サーバの共有トークン（#216）。relay/.env の RELAY_TOKEN と**同じ値**にする。
// 全リクエストの X-Relay-Token ヘッダに載る。値が違うと中継サーバは 401 を返し、
// 端末側は「Wi-Fi は繋がるのに返事が来ない」症状になる。
//
// ⚠ 下の値は**わざと短くしてある**。書き換えないと中継サーバ側が起動を拒否する
//   （テンプレートのままの値は public リポジトリに載っているため、認証の意味が無くなる）。
//
// 生成例: openssl rand -hex 16
//   （PowerShell なら
//    -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })）
#define RELAY_TOKEN "CHANGE_ME"
